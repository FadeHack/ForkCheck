  "segments": [
    {
      "id": "heldout-scope-docs-migration:seg:0",
      "text": "The old docs platform contract ends on the 30th, and they won't extend month to month."
    },
    {
      "id": "heldout-scope-docs-migration:seg:1",
      "text": "The new site is up. Search works, versioning works. It just has no content."
    },
    {
      "id": "heldout-scope-docs-migration:seg:2",
      "text": "How many pages are we talking about?"
    },
    {
      "id": "heldout-scope-docs-migration:seg:3",
      "text": "About three hundred on the old platform. Some of it hasn't been touched in two years."
    },
    {
      "id": "heldout-scope-docs-migration:seg:4",
      "text": "OK. Nkechi, can you migrate the docs to the new site by the 20th? That gives us ten days of slack."
    },
    {
      "id": "heldout-scope-docs-migration:seg:5",
      "text": "By the 20th, yes. I'll script the conversion and fix the tables by hand."
    },
    {
      "id": "heldout-scope-docs-migration:seg:6",
      "text": "Redirects too, please. We have a lot of inbound links from forums."
    },
    {
      "id": "heldout-scope-docs-migration:seg:7",
      "text": "I'll generate a redirect map from the old URLs."
    },
    {
      "id": "heldout-scope-docs-migration:seg:8",
      "text": "Ivo, can you set up the redirect rules once Nkechi has the map?"
    },
    {
      "id": "heldout-scope-docs-migration:seg:9",
      "text": "Yes."
    },
    {
      "id": "heldout-scope-docs-migration:seg:10",
      "text": "And let's freeze edits on the old platform from the 16th."
    },
    {
      "id": "heldout-scope-docs-migration:seg:11",
      "text": "I'll post the freeze in the docs channel."
    },
    {
      "id": "heldout-scope-docs-migration:seg:12",
      "text": "Great, thanks."
    }
  ],
