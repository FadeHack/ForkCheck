  "segments": [
    {
      "id": "heldout-debated-on-call-rotation:seg:0",
      "text": "The on-call survey is in. People in London are getting paged at three in the morning for US traffic."
    },
    {
      "id": "heldout-debated-on-call-rotation:seg:1",
      "text": "Follow-the-sun fixes that. London covers the day here, Austin covers the day there."
    },
    {
      "id": "heldout-debated-on-call-rotation:seg:2",
      "text": "Austin has two people who know the payment system. That's not enough for a rotation."
    },
    {
      "id": "heldout-debated-on-call-rotation:seg:3",
      "text": "We train more. It's six weeks of shadowing."
    },
    {
      "id": "heldout-debated-on-call-rotation:seg:4",
      "text": "Six weeks where incidents take longer. I'm not comfortable with that before the holiday peak."
    },
    {
      "id": "heldout-debated-on-call-rotation:seg:5",
      "text": "Both fair. I don't want to force a decision now."
    },
    {
      "id": "heldout-debated-on-call-rotation:seg:6",
      "text": "Can we at least start the shadowing?"
    },
    {
      "id": "heldout-debated-on-call-rotation:seg:7",
      "text": "Shadowing alone I'm fine with."
    },
    {
      "id": "heldout-debated-on-call-rotation:seg:8",
      "text": "OK. Andile, set up shadowing for two Austin engineers. The rotation itself we leave open until January."
    },
    {
      "id": "heldout-debated-on-call-rotation:seg:9",
      "text": "Will do."
    }
  ],
