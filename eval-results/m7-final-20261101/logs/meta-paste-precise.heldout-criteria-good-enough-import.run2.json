  "segments": [
    {
      "id": "heldout-criteria-good-enough-import:seg:0",
      "text": "Lindqvist Dental wants to start moving their patient records next week. They're asking about the importer."
    },
    {
      "id": "heldout-criteria-good-enough-import:seg:1",
      "text": "The CSV importer works. It's rough around the edges, but it works."
    },
    {
      "id": "heldout-criteria-good-enough-import:seg:2",
      "text": "Rough how?"
    },
    {
      "id": "heldout-criteria-good-enough-import:seg:3",
      "text": "Error messages are just row numbers, and it's slow on big files."
    },
    {
      "id": "heldout-criteria-good-enough-import:seg:4",
      "text": "They don't need it perfect. It needs to be good enough for the client to start using."
    },
    {
      "id": "heldout-criteria-good-enough-import:seg:5",
      "text": "Fair. Then I'll get it good enough for them by Tuesday."
    },
    {
      "id": "heldout-criteria-good-enough-import:seg:6",
      "text": "I'll write a short guide on the column format, with a template file."
    },
    {
      "id": "heldout-criteria-good-enough-import:seg:7",
      "text": "Great. I'll tell them Tuesday."
    },
    {
      "id": "heldout-criteria-good-enough-import:seg:8",
      "text": "Do they need the appointment history too, or just patients?"
    },
    {
      "id": "heldout-criteria-good-enough-import:seg:9",
      "text": "Patients first. Appointments can come later."
    },
    {
      "id": "heldout-criteria-good-enough-import:seg:10",
      "text": "Good, that keeps it simpler."
    },
    {
      "id": "heldout-criteria-good-enough-import:seg:11",
      "text": "Thanks, all."
    }
  ],
