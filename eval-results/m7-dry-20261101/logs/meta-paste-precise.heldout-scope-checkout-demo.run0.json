  "segments": [
    {
      "id": "heldout-scope-checkout-demo:seg:0",
      "text": "Hartwell Outdoor confirmed the demo for Thursday the 12th. Their CFO is joining."
    },
    {
      "id": "heldout-scope-checkout-demo:seg:1",
      "text": "Is this about the one-page checkout?"
    },
    {
      "id": "heldout-scope-checkout-demo:seg:2",
      "text": "Yes. It's the main reason they're looking at us. Their current checkout is five steps."
    },
    {
      "id": "heldout-scope-checkout-demo:seg:3",
      "text": "The one-page flow works on my branch. Card and wallet payments both go through in test mode."
    },
    {
      "id": "heldout-scope-checkout-demo:seg:4",
      "text": "Tax calculation is still the old service, though. It's slow on the first call."
    },
    {
      "id": "heldout-scope-checkout-demo:seg:5",
      "text": "I can warm it before the demo."
    },
    {
      "id": "heldout-scope-checkout-demo:seg:6",
      "text": "Then let's have the new checkout ready for the Hartwell demo. Ottilie owns it, Sam helps with tax."
    },
    {
      "id": "heldout-scope-checkout-demo:seg:7",
      "text": "Ready for the twelfth, got it."
    },
    {
      "id": "heldout-scope-checkout-demo:seg:8",
      "text": "Sure, I'll look at caching the tax rates."
    },
    {
      "id": "heldout-scope-checkout-demo:seg:9",
      "text": "I'll send them the agenda tomorrow. Thirty minutes, checkout first."
    },
    {
      "id": "heldout-scope-checkout-demo:seg:10",
      "text": "Do we show the admin side too?"
    },
    {
      "id": "heldout-scope-checkout-demo:seg:11",
      "text": "Only if they ask. Keep it on the buyer flow."
    },
    {
      "id": "heldout-scope-checkout-demo:seg:12",
      "text": "Makes sense."
    },
    {
      "id": "heldout-scope-checkout-demo:seg:13",
      "text": "Thanks, everyone."
    }
  ],
