  "segments": [
    {
      "id": "heldout-debated-starter-price:seg:0",
      "text": "Proposal: raise the Starter plan from twelve to fifteen dollars a seat, from January."
    },
    {
      "id": "heldout-debated-starter-price:seg:1",
      "text": "I don't agree. Starter is how most of our big accounts started. A price jump hits the funnel."
    },
    {
      "id": "heldout-debated-starter-price:seg:2",
      "text": "Our costs per seat went up a lot this year, though. Starter is barely above break-even."
    },
    {
      "id": "heldout-debated-starter-price:seg:3",
      "text": "Then cut the free storage on Starter instead of the price. Nobody shops on storage."
    },
    {
      "id": "heldout-debated-starter-price:seg:4",
      "text": "That annoys existing customers more than a price change."
    },
    {
      "id": "heldout-debated-starter-price:seg:5",
      "text": "We don't know that. We've never tested either."
    },
    {
      "id": "heldout-debated-starter-price:seg:6",
      "text": "Could we test it on new signups only?"
    },
    {
      "id": "heldout-debated-starter-price:seg:7",
      "text": "Maybe. I don't think we're going to agree today."
    },
    {
      "id": "heldout-debated-starter-price:seg:8",
      "text": "No. Let's revisit this next week with the cohort numbers."
    },
    {
      "id": "heldout-debated-starter-price:seg:9",
      "text": "I'll pull the cohort numbers for Starter before then."
    },
    {
      "id": "heldout-debated-starter-price:seg:10",
      "text": "OK. Nothing changes until we decide."
    }
  ],
