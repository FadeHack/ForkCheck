  "segments": [
    {
      "id": "heldout-outcome-reporting-pilot:seg:0",
      "text": "The new reporting dashboards are feature complete. Pavel, how's performance?"
    },
    {
      "id": "heldout-outcome-reporting-pilot:seg:1",
      "text": "Under two seconds for every chart on our biggest test workspace."
    },
    {
      "id": "heldout-outcome-reporting-pilot:seg:2",
      "text": "The CSV export from the charts is in too."
    },
    {
      "id": "heldout-outcome-reporting-pilot:seg:3",
      "text": "Great. Then let's ship it to the pilot group on Monday."
    },
    {
      "id": "heldout-outcome-reporting-pilot:seg:4",
      "text": "Monday works. I'll flip the flag first thing."
    },
    {
      "id": "heldout-outcome-reporting-pilot:seg:5",
      "text": "I'll write the what's-new note that shows up when they open reporting."
    },
    {
      "id": "heldout-outcome-reporting-pilot:seg:6",
      "text": "Keep it short. Three bullets and a link."
    },
    {
      "id": "heldout-outcome-reporting-pilot:seg:7",
      "text": "Sure."
    },
    {
      "id": "heldout-outcome-reporting-pilot:seg:8",
      "text": "Do we want usage tracking on each chart?"
    },
    {
      "id": "heldout-outcome-reporting-pilot:seg:9",
      "text": "Yes, chart opens and exports. I'll want those numbers in two weeks."
    },
    {
      "id": "heldout-outcome-reporting-pilot:seg:10",
      "text": "I'll add the events before Monday."
    },
    {
      "id": "heldout-outcome-reporting-pilot:seg:11",
      "text": "Thanks, both."
    }
  ],
