# Copy to .env.local at the repository root and fill in what you need.
# .env.local is gitignored. Never commit real keys.

# Set to 1 to allow live model and transcription calls. Leave 0 for tests and CI.
LIVE=0

# Set to 1 (with LIVE=1) to record model responses as test fixtures in packages/ai/fixtures.
# Fixtures are committed, so record synthetic meetings only.
RECORD_FIXTURES=0

# Meta API key (LLM_<id>_<secret>). Required when LIVE=1.
MODEL_API_KEY=

# Baseten API key. Only the model comparison in the eval harness uses it.
BASETEN_API_KEY=

# Postgres for local development (docker compose). Tests use in-memory PGlite instead.
DATABASE_URL=postgres://forkcheck:forkcheck@localhost:5433/forkcheck

# Where uploaded audio is kept: local disk or Vercel Blob.
STORAGE_DRIVER=local
AUDIO_DIR=var/audio
# Required when STORAGE_DRIVER=blob.
BLOB_READ_WRITE_TOKEN=

# ffmpeg binary used to convert uploads to 24 kHz mono WAV. Defaults to ffmpeg on PATH.
FFMPEG_PATH=

# Spend caps in USD. Live calls stop once a cap is reached.
SPEND_CAP_USD=100
BASETEN_SPEND_CAP_USD=60
