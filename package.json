{
  "name": "forkcheck",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @forkcheck/web dev",
    "build": "pnpm --filter @forkcheck/web build",
    "e2e": "pnpm --filter @forkcheck/web e2e",
    "env:check": "tsx packages/config/scripts/check-env.ts",
    "probe:meta": "tsx packages/ai/scripts/probe-meta.ts",
    "probe:transcribe": "tsx packages/asr/scripts/probe-transcribe.ts",
    "probe:baseten": "tsx packages/eval/scripts/probe-baseten.ts",
    "probe:schemas": "tsx packages/ai/scripts/probe-schemas.ts",
    "smoke:model": "tsx packages/ai/scripts/smoke-call-model.ts",
    "smoke:transcribe": "tsx packages/eval/scripts/smoke-transcribe.ts",
    "eval": "tsx packages/eval/scripts/eval.ts",
    "eval:run": "tsx packages/eval/scripts/run.ts",
    "loop": "tsx packages/eval/scripts/loop.ts",
    "gate": "tsx packages/eval/scripts/gate.ts",
    "tiers": "tsx packages/eval/scripts/tiers.ts",
    "audio:render": "tsx packages/eval/scripts/audio-render.ts",
    "eval:s1": "tsx packages/eval/scripts/s1.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose stop",
    "db:migrate": "tsx packages/db/scripts/migrate.ts",
    "db:generate": "pnpm --filter @forkcheck/db db:generate",
    "lint": "eslint .",
    "typecheck": "pnpm -r --parallel typecheck",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm depcruise && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
